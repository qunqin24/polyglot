bin/
# The runtime data directory at the repository root only; a source folder
# named data (web/src/components/layout/data) must not be caught by it.
/data/
node_modules/
.pnpm-store/
.eslintcache
*.tsbuildinfo
*.db
*.db-wal
*.db-shm
secret.key
.DS_Store
.env

# The WebUI bundle is a build artifact. Only .gitkeep is tracked, so the
# go:embed directive still resolves on a fresh clone.
web/dist/*
!web/dist/.gitkeep
